{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "shared/**/*.ts",
    "cv-generator/**/*.ts",
    "automation/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "ui"]
}
