# Obligatorio para parsear el CV, redactar variantes y cartas de presentación.
ANTHROPIC_API_KEY=

# Opcional. Por defecto: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# En Vercel estas tres van en Settings → Environment Variables (no en localhost).
# Link de la hoja de Google (docs.google.com/spreadsheets/d/...).
GOOGLE_SHEET_URL=

# JSON de cuenta de servicio con permiso Editor sobre la hoja, en una sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternativa local: ruta a un archivo JSON.
GOOGLE_APPLICATION_CREDENTIALS=

# Solo para tests / CI. La postulación automática SIEMPRE corre headed
# salvo que pongas esto en 1 (no lo uses en corridas reales).
PLAYWRIGHT_HEADLESS=0
