# Obligatorio para parsear el CV, redactar variantes y cartas de presentación.
ANTHROPIC_API_KEY=

# Opcional. Por defecto: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# Opcional: planilla de Google. Ruta a un JSON de cuenta de servicio
# con permiso de edición sobre la hoja.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternativa: pegar el JSON de la cuenta de servicio en una sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Solo para tests / CI. La postulación automática SIEMPRE corre headed
# salvo que pongas esto en 1 (no lo uses en corridas reales).
PLAYWRIGHT_HEADLESS=0
